# --- Database ---
# sqlite (default, zero-config) | postgresql
DB_TYPE=sqlite
DB_PATH=../data/demo_database/demo.db

# Only used when DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datatalk
DB_USER=postgres
DB_PASSWORD=

# --- LLM provider ---
# rulebased (default, no key needed, deterministic templates) | openai | groq | gemini
LLM_PROVIDER=rulebased
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
# Leave blank for OpenAI/Groq's default endpoint; override for any other
# OpenAI-compatible provider.
LLM_BASE_URL=

# --- RAG ---
VECTOR_STORE=tfidf
RAG_TOP_K=5

# --- Safety / execution ---
SQL_ROW_LIMIT=500
SQL_TIMEOUT_SECONDS=10
MAX_SQL_RETRIES=2
PROBE_ROW_LIMIT=20

# --- Feature flags ---
ENABLE_INTENT_ANALYSIS=true
ENABLE_UNCERTAINTY=true
ENABLE_DB_PROBING=false
ENABLE_CLARIFICATION=false
ENABLE_RESULT_VERIFICATION=true
ENABLE_POWERBI=false

# --- Power BI (Stage 5, optional — see docs/powerbi_setup.md) ---
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=
POWERBI_REPORT_ID=
